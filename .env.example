# Required — Channel bot tokens (set via setup wizard or manually)
TELEGRAM_BOT_TOKEN=your_token_here
DISCORD_BOT_TOKEN=your_token_here

# Optional — "Discuss" live voice feature (requires both keys)
OPENAI_API_KEY=your_openai_key_here
CALL_SERVER_URL=https://your-public-domain.example.com
CALL_SERVER_PORT=3147

# Optional — Voice message transcription (STT)
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional — Read Aloud (TTS) via Resemble AI
RESEMBLE_API_KEY=your_resemble_key_here
RESEMBLE_VOICE_UUID=                          # optional, auto-fetches first available voice
